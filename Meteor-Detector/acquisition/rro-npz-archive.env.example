# Copy to /etc/default/rro-npz-archive and edit the remote name/path.
# Do not put an OAuth secret in this file; rclone stores its token in its own
# config with restrictive permissions.
RRO_ARCHIVE_SOURCE_DIR=/home/sudeep/fm_observations
RRO_ARCHIVE_REMOTE=gdrive-rro
RRO_ARCHIVE_PATH=remote-radio-observatory/npz
RRO_ARCHIVE_RETENTION_HOURS=720
RRO_ARCHIVE_MIN_FREE_GB=1
